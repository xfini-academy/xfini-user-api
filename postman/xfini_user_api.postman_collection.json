                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/getToken",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "getToken"]
                }
              },
              "status": "Internal Server Error",
              "code": 500,
              "_postman_previewlanguage": "json",
