                  "    pm.expect(jsonData.targetDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "    pm.expect(jsonData.count).to.be.a(\"number\");",
                  "    pm.expect(jsonData.students).to.be.an(\"array\");",
