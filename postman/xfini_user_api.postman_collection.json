      "description": "Endpoints for creating students, managing course assignments, and tracking subscription expiries.",
      "item": [
        {
          "name": "Create Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 400\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Student created successfully\", function () {",
                  "        const jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.userId).to.be.a(\"string\");",
                  "        pm.expect(jsonData.email).to.be.a(\"string\");",
                  "        pm.expect(jsonData.subscriptionId).to.be.a(\"string\");",
                  "        pm.expect(jsonData.endDate).to.be.a(\"string\");",
                  "        ",
                  "        pm.collectionVariables.set(\"lastCreatedUserId\", jsonData.userId);",
                  "        pm.collectionVariables.set(\"lastSubscriptionId\", jsonData.subscriptionId);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
