    {
      "name": "Authentication",
      "description": "Endpoints for obtaining Firebase authentication tokens for administrative and authorized operations.",
      "item": [
        {
          "name": "Get Admin ID Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response indicates success\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.idToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.expiresIn).to.exist;",
                  "    ",
                  "    // Store token in collection & environment variable for subsequent requests",
                  "    pm.collectionVariables.set(\"idToken\", jsonData.idToken);",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"idToken\", jsonData.idToken);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/getToken",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getToken"]
            },
            "description": "Signs in using ADMIN_EMAIL and ADMIN_PASSWORD configured in the server environment via the Google Identity Toolkit REST API and returns a short-lived Firebase ID token (valid for 1 hour). Automatically sets the `idToken` collection variable upon success."
          },
          "response": [
            {
              "name": "200 Success - Token Generated",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/getToken",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "getToken"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"idToken\": \"eyJhbGciOiJSUzI1NiIsImtpZCI6IjEyMzQ1NiIsInR5cCI6IkpXVCJ9..signature\",\n  \"expiresIn\": \"3600\"\n}"
            },
            {
              "name": "401 Unauthorized - Invalid Credentials",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
