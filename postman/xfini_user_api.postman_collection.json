                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": \"INVALID_LOGIN_CREDENTIALS\"\n}"
            },
            {
              "name": "500 Server Error - Missing Configuration",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
