{
  "name": "xfini-user-api",
  "version": "1.1.0",
  "description": "Standalone REST API for Xfini user creation",
  "main": "index.js",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "node --check index.js && node --check firebaseAdmin.js",
    "test": "node --experimental-test-module-mocks --test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
