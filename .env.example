# Firebase Web API key — used by /api/getToken to sign in via the Identity Toolkit REST API
# Get from Google Cloud Console > APIs & Services > Credentials (Identity Toolkit API key)
FIREBASE_API_KEY=your-firebase-web-api-key

# Admin Firebase account — must have role: "admin" in Firestore users collection
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Optional — defaults to 3001
PORT=3001

# Optional — path to the local SQLite file backing GET /stats. Defaults to ./data/stats.db
# STATS_DB_PATH=./data/stats.db

# ngrok auth token — get from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# Firebase credentials as JSON string (alternative to serviceAccount.json file)
# Required when running via Docker; paste the full contents of serviceAccount.json as one line
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional — overrides the image pulled by docker-compose.yml (defaults to ghcr.io/xfini-academy/xfini-user-api:latest)
# DOCKER_IMAGE=ghcr.io/your-org/your-fork:tag
